# ─────────────────────────────────────────────────────────────────────────────
#  MY LIGA — muhit o'zgaruvchilari
#
#  Bu faylni `.env.local` deb nusxalang va qiymatlarni to'ldiring.
#  `.env.local` git'ga TUSHMAYDI (.gitignore'da), shuning uchun kalitlar xavfsiz.
#
#  Qiymatlarni qayerdan olish: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Loyihangiz URL'i. Brauzerga ham yuboriladi — maxfiy emas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# "anon / public" kaliti. Brauzerga yuboriladi — maxfiy emas.
# Xavfsizlik RLS siyosatlari orqali ta'minlanadi, kalitni yashirish orqali emas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ MAXFIY — "service_role" kaliti. RLS'ni BUTUNLAY chetlab o'tadi.
# Faqat serverda ishlatiladi (lib/supabase/admin.ts). Hech qachon brauzerga
# yubormang, hech qachon git'ga qo'ymang, hech kimga ko'rsatmang.
# Agar sizib chiqqan bo'lsa — Supabase Dashboard'dan darhol almashtiring.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Birinchi Super Admin emaili (ixtiyoriy).
# Shu email bilan Google orqali kirgan foydalanuvchi avtomatik 'super_admin'
# rolini oladi — birinchi adminni qo'lda SQL yozmasdan yaratish uchun.
#
# MUHIM: bu SERVER-ONLY o'zgaruvchi — `NEXT_PUBLIC_` prefiksi QO'YMANG.
# Prefiks bilan bo'lsa, email brauzer kodiga chiqib oshkor bo'ladi.
SUPER_ADMIN_EMAIL=siz@example.com

# ─────────────────────────────────────────────────────────────────────────────
#  Web Push bildirishnomalar (ixtiyoriy — sozlanmasa push jimgina o'chiq bo'ladi)
#
#  VAPID kalitlarini yaratish (bir marta):  npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────

# Ochiq kalit — brauzerga ham boradi, maxfiy emas.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ⚠️ MAXFIY — VAPID shaxsiy kaliti. Faqat serverda, hech qachon git'ga qo'ymang.
VAPID_PRIVATE_KEY=

# Push "subject" — mailto: yoki sayt URL'i (aloqa uchun).
VAPID_SUBJECT=mailto:kamronbekravshanov17@gmail.com

# O'yin eslatmasi cron uchun maxfiy kalit (o'zingiz tasodifiy uzun matn yozing).
# Tashqi cron (cron-job.org) shu kalitni "Authorization: Bearer <kalit>" sarlavhasida yuboradi.
CRON_SECRET=
